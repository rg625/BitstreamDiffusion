__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# PyTorch / Triton / Inductor caches
torch_compile_debug/
.torch_compile_cache/
.triton_cache/

# Project-specific large/transient data
# datasets/  — symlinks to dataset caches; rebuild via scripts/lm1b/ and scripts/owt/
datasets/
# runs/      — training outputs, checkpoints, eval results
runs/
# logs/      — SLURM job logs and stdout/stderr captures
logs/
# hf_cache  — HuggingFace model cache symlink (gpt2-large, tokenizers, etc.)
hf_cache
hf_cache/
# wandb/     — Weights & Biases run directory
wandb/
generated_samples/
generated_output.png

# Model checkpoints (anywhere they accidentally land outside runs/)
*.pth
*.pt
*.ckpt
# Exception: entropy-rate schedule artefacts that ship with the repo and are
# loaded at evaluation time (assets/entropy_tables/<dataset>/entropy_*.pt).
!assets/entropy_tables/**/*.pt

# Crash dumps
core
core.*

# task experiment artifacts (regenerable)
datasets/sudoku/
datasets/tinygsm/
datasets/tinygsm_smoke/
logs/tasks/

# CFG-FKC 2D/1D demo generated figures + artifact (regenerable via scripts/fkc_cfg_2d_demo.py)
scripts/_fkc_cfg_2d_out/

# Guidance analysis: per-step diagnostics are ~19 MB and regenerate from runs/
results/guidance/per_step.csv

# Production-era checkpoints, 18 GB. They are data, not source: the anchor
# travels with the checkpoint bundle (scripts/site/transfer_manifest.txt),
# never through git.
tinigsm_gsm8k/

# Stray LaTeX build artefacts at the repo root; the real ones live in
# docs/report_meeting/.
/report.aux
/report.log
/report.out
/report.pdf
